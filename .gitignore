__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local assistant/workspace scratch
.claude/
.agents/
/PRIVATE.md

# Curated release-upload staging (large installers, built locally, uploaded by hand)
/_github_assets/
/_github_assets_beta/

# Local investigation scratch (replays, samples, throwaway scripts)
/work_in_progress/

# Pipeline reports: the tools/*.py builders write merge warnings, manifests and
# validation summaries here, and reports/replay_stats/ holds replay-corpus statistics
# (large, derived from a local folder of .replay files that is not in the repo).
/reports/

# Leftovers of an interrupted tools/build_army_corps_catalog.py staging swap.
/assets/army_corps_by_theatre.staging/
/assets/army_corps_by_theatre.old/


# Analysis checkpoints (analysis/class_structure.py resumes from these)
/analysis/.cache/
# Row-level replay-derived data (veteran study: builds, player names, rankings) stays local
/analysis/local/
/blind_study

# Downloaded replay corpora (tools/download_redcoatz_replays.py; ~1-1.5 GB)
/replays/

# Importable optimal-build files (analysis/export_builds_for_app.py, analysis/experiments/two_compartment.py):
# thousands of regenerable JSON builds. The reports and CSVs describing them stay tracked.
/analysis/output/app_builds*/*.json
/analysis/output/top_builds_backup*.json

# Blind AC study: per-experiment prediction arrays (binary, regenerated by its scripts)
/analysis/ac_blind/out/*.npy

# Team study: every ToW / Custom team of four (7.8 MB, regenerated in seconds by analysis/team_search.py)
/analysis/output/teams/teams_tow*.csv
